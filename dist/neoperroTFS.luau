do
    function Library:SetMenuMouseCapture(State)
        local Run = game:GetService("RunService")
        if State then
            if not Library.MenuMouseBound then
                Library.MenuMouseBound = true
                Library.MenuMouseOriginal = UserInput.MouseBehavior
                Run:BindToRenderStep("NeoperroMenuMouse", Enum.RenderPriority.Last.Value + 2, function()
                    if not Library.Destroyed and Library.WindowVisible and isrbxactive()
                        and (not Library.Automation or Library.Automation.WindowFocused ~= false) then
                        local Right = not GuiService.MenuIsOpen and UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                        if not Right then
                            Library.MenuCameraDragging = false
                        elseif not Library.MenuCameraDragging then
                            local Window = Library.WindowInstance
                            local OverUI = Window and ((Window.MainBounds and Utility.OnMouse(Window.MainBounds))
                                or (Window.BindPanelBounds and Utility.OnMouse(Window.BindPanelBounds)))
                            Library.MenuCameraDragging = not OverUI and not Library.CapturingMenuKey and UserInput:GetFocusedTextBox() == nil
                        end
                         
                        if not Library.MenuCameraDragging then UserInput.MouseBehavior = Enum.MouseBehavior.Default end
                        UserInput.MouseIconEnabled = true
                    end
                end)
            end
            UserInput.MouseBehavior = Enum.MouseBehavior.Default
        elseif Library.MenuMouseBound then
            Run:UnbindFromRenderStep("NeoperroMenuMouse")
            Library.MenuMouseBound = false
            if not GuiService.MenuIsOpen and UserInput.MouseBehavior == Enum.MouseBehavior.Default and Library.MenuMouseOriginal then
                UserInput.MouseBehavior = Library.MenuMouseOriginal
            end
            Library.MenuMouseOriginal = nil
            Library.MenuCameraDragging = false
        end
    end
    function Library:ChangeVisible(State)
        Library.WindowVisible = State
        Library:SetMenuMouseCapture(State)
        if Library.Automation then
             
            Library.Automation:ReleaseMouse(); Library.Automation:Sprint(false)
            Library.Automation:RestoreView()
        end
        UserInput.MouseIconEnabled = true
        if not State and Library.WindowInstance then Library.WindowInstance:ClosePopups() end
        for _, Entry in ipairs(Library.Drawings) do
            local Object = Entry[1]
            local Info = Library.DrawingInfo[Object]
            if Info and not Info.Hitbox then
                Utility.Fade(Object, State and Info.Alpha or 0, State and 0.16 or 0.12)
            end
        end
        Library:SetBindListVisible(Library.BindListVisible)
    end
    function Library:UpdateTheme(Config)
        for _, Key in ipairs({"Accent", "Outline", "Inline", "LightContrast", "DarkContrast", "Text", "TextInactive"}) do
            local Value = Config[Key]
            if Value then
                if Key == "Accent" then Library.Theme.Accent[1] = Value else Library.Theme[Key] = Value end
                Library.Communication:Fire(Key, Value)
            end
        end
    end
    function Library.SelfDestruct()
        if Library.Destroyed then return end
        Library:SetMenuMouseCapture(false)
        if Library.Visuals then pcall(Library.Visuals.Destroy, Library.Visuals) end
        if Library.Automation then pcall(Library.Automation.Destroy, Library.Automation) end
        if Library.Features then pcall(Library.Features.Destroy, Library.Features) end
        Library.Destroyed = true
        if Library.MotionConnection then Library.MotionConnection:Disconnect(); Library.MotionConnection = nil end
        table.clear(Library.Motion)
        table.clear(Library.DragGroups)
        UserInput.MouseIconEnabled = OriginalMouseIcon
        for _, Connection in ipairs(Library.Connections) do Connection:Disconnect() end
        for Object in pairs(Library.DrawingInfo) do pcall(function() Object:Remove() end) end
        table.clear(Library.DrawingInfo)
        table.clear(Library.Connections)
        InputGUI:Destroy()
        Library.Communication:Destroy()
        if getgenv().NeoperroTFS == Library then getgenv().NeoperroTFS = nil end
        if getgenv().Library == Library then getgenv().Library = nil end
        if getgenv().Utility == Utility then getgenv().Utility = nil end
    end
    Library.Destroy = Library.SelfDestruct
    if STATE then STATE.onCleanup(Library.SelfDestruct) end
    function Library:SetMenuKey(Key)
        assert(typeof(Key) == "EnumItem" and Key.EnumType == Enum.KeyCode and Key ~= Enum.KeyCode.Unknown and Key ~= Enum.KeyCode.Escape, "Choose a keyboard key other than Escape")
        Library.MenuKey = Key
        Library.Flags.MenuKey = Key.Name
        if Library.MenuKeyButton then Library.MenuKeyButton:SetText("SHOW / HIDE UI: " .. string.upper(Key.Name)) end
    end
    function Library:BeginMenuKeyCapture()
        Library.CapturingMenuKey = true
        if Library.MenuKeyButton then Library.MenuKeyButton:SetText("PRESS A KEY (ESC CANCELS)") end
    end
    function Library.HandleMenuInput(Input)
        if Library.CapturingMenuKey then
            if Input.UserInputType ~= Enum.UserInputType.Keyboard then return true end
            Library.CapturingMenuKey = false
            if Input.KeyCode ~= Enum.KeyCode.Escape and Input.KeyCode ~= Enum.KeyCode.Unknown then Library:SetMenuKey(Input.KeyCode)
            elseif Library.MenuKeyButton then Library.MenuKeyButton:SetText("SHOW / HIDE UI: " .. Library.MenuKey.Name) end
            return true
        end
        local TextBox = UserInput:GetFocusedTextBox()
         
         
        for _, Bind in ipairs(Library.Bindings) do
            if Bind.Binding and Bind.HandleMenuInput then
                Bind:HandleMenuInput(Input)
                return true
            end
        end
        if Input.KeyCode == Library.MenuKey and (not TextBox or GuiService.MenuIsOpen) then
            Library:ChangeVisible(not Library.WindowVisible)
            return true
        end
        local Pointer = Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.MouseButton2 or Input.UserInputType == Enum.UserInputType.MouseButton3
         
         
        if TextBox and not Pointer then return true end
        if Library.WindowVisible then
            for _, Bind in ipairs(Library.Bindings) do
                if Bind.Dropped and Bind.HandleMenuInput and Bind:HandleMenuInput(Input) then return true end
            end
            for _, Bind in ipairs(Library.Bindings) do
                if Bind.HandleMenuInput and Bind:HandleMenuInput(Input) then return true end
            end
        end
        return false
    end
    Library:SetMenuKey(Enum.KeyCode.RightShift)
    Utility.AddConnection("WindowFocusReleased", function()
        for _, Bind in ipairs(Library.Bindings) do
            if Bind.StateType == "Hold" and Bind.State then
                Bind.State = false; Bind.Callback(false, Bind.Key)
            end
        end
        if Library.WindowInstance then Library.WindowInstance.RefreshBinds() end
    end)
    function Library:SetBindListVisible(State)
        Library.BindListVisible = State
        local Show = State and Library.WindowVisible
        for _, Entry in ipairs(Library.Keybind) do
            local Object = Entry[1]
            local Info = Library.DrawingInfo[Object]
            if Info and Info.InitialVisible then
                if Show then
                    if not Object.Visible then Object.Transparency = 0 end
                    Object.Visible = true
                end
                Utility.Fade(Object, Show and Info.Alpha or 0, 0.12, function()
                    if not (Library.BindListVisible and Library.WindowVisible) then Object.Visible = false end
                end)
            end
        end
    end
