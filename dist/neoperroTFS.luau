local CreateFeatures = (function()
 
return function(Library: any, Window: any)
    local P: any = game:GetService("Players").LocalPlayer
    local Run = game:GetService("RunService")
    local Input = game:GetService("UserInputService")
    local F: any = {Alive = true, Connections = {}, Weapons = {}, Values = {},
        Retries = {}, Callbacks = {}, Notices = {}, LastApply = 0}
    local Flags = Library.Flags
    local Keys = {"GunRapidFire", "GunNoSpread", "GunNoRecoil", "FarmAutoShoot"}
    local function Notify(Key, Message)
        if F.Notices[Key] == Message then return end
        F.Notices[Key] = Message
        Window.SendNotification("Warning", Message, 4)
    end
    local function Connect(Signal, Callback)
        local C = Signal:Connect(Callback)
        table.insert(F.Connections, C)
        return C
    end
    local function Disconnect(Connection)
        pcall(function() Connection:Disconnect() end)
    end
    local function NeedUpdates()
        for _, Key in ipairs(Keys) do if Flags[Key] == true then return true end end
        return false
    end
    function F:RequestedRate()
        local Rate = tonumber(Flags.GunFireRate)
        if not Rate or Rate ~= Rate or math.abs(Rate) == math.huge then Rate = 60 end
        return math.clamp(Rate, 1, 120)
    end
    local function Assign(Value, Desired, Enabled)
        if not Value or not Value:IsA("ValueBase") then return false end
        local Record = F.Values[Value]
        if Enabled then
            if not Record then
                Record = {Original = Value.Value, Applied = Desired}
                F.Values[Value] = Record
            elseif Value.Value ~= Record.Applied then
                 
                Record.Original = Value.Value
            end
            local Before = Value.Value
            if Before ~= Desired then Value.Value = Desired end
            Record.Applied = Value.Value
            return Value.Value ~= Before
        elseif Record then
            local Changed = Value.Value == Record.Applied and Value.Value ~= Record.Original
            if Value.Value == Record.Applied then Value.Value = Record.Original end
            F.Values[Value] = nil
            return Changed
        end
        return false
    end
    function F:RestoreValues(Tool)
        for Value, Record in pairs(self.Values) do
            local OK, Matches = pcall(function() return not Tool or Value:IsDescendantOf(Tool) end)
            if not OK or Matches then
                pcall(function() if Value.Value == Record.Applied then Value.Value = Record.Original end end)
                self.Values[Value] = nil
            end
        end
    end
    function F:RestoreWeapon(B)
        if B.RecoilIndex then
            pcall(function()
                if debug.getupvalue(B.Fire, B.RecoilIndex) == B.RecoilProxy then
                    debug.setupvalue(B.Fire, B.RecoilIndex, B.Recoil)
                end
            end)
        end
         
        if B.UpdateSpread then pcall(B.UpdateSpread) end
    end
    function F:ReleaseWeapon(Tool)
        self:RestoreValues(Tool)
        local B = self.Weapons[Tool]
        if B then self:RestoreWeapon(B); self.Weapons[Tool] = nil end
        self.Retries[Tool] = nil
    end
    function F:BindWeapon(Tool)
        local Script = Tool:FindFirstChild("GunScript")
        local B = self.Weapons[Tool]
        if B and B.Script == Script then return B end
        if B then self:ReleaseWeapon(Tool) end
        if not Script then return nil end
        local Now = os.clock()
        local Retry = self.Retries[Tool]
        if Retry and Now - Retry.Last < 1 then return nil end
        self.Retries[Tool] = {Last = Now}
        local OK, Environment = pcall(getsenv, Script)
        if not OK then return nil end
        local Fire = filtergc("function", {Name = "FireWeapon", Environment = Environment}, true)
        if not Fire then return nil end  
        B = {Tool = Tool, Script = Script, Environment = Environment, Fire = Fire}
        for Index = 1, math.min(debug.getinfo(Fire).nups, 128) do
            local V = debug.getupvalue(Fire, Index)
            if type(V) == "table" and type(V.GetIgnoreList) == "function" then B.Manager = V end
            if not B.RecoilIndex and type(V) == "table" and type(V.AddRecoil) == "function" then
                B.RecoilIndex, B.Recoil = Index, V
            end
        end
        if B.RecoilIndex then
            local Recoil = B.Recoil
            B.RecoilProxy = setmetatable({}, {__index = Recoil})
            function B.RecoilProxy:AddRecoil(...)
                if Flags.GunNoRecoil ~= true or F.Suspended then return Recoil.AddRecoil(Recoil, ...) end
                return nil
            end
            debug.setupvalue(Fire, B.RecoilIndex, B.RecoilProxy)
        elseif Flags.GunNoRecoil == true then
            Notify("recoil-" .. Tool.Name, "No recoil is unavailable for " .. Tool.Name)
        end
        B.UpdateSpread = filtergc("function", {Name = "UpdateSpread", Environment = Environment}, true)
        if not B.UpdateSpread and Flags.GunNoSpread == true then
            Notify("spread-" .. Tool.Name, "No spread is unavailable for " .. Tool.Name)
        end
        self.Weapons[Tool] = B
        self.Retries[Tool] = nil
        return B
    end
    function F:ApplyTool(Tool)
        local BindingNeed = (Flags.GunNoSpread == true or Flags.GunNoRecoil == true or Flags.FarmAutoShoot == true)
        local B = BindingNeed and self:BindWeapon(Tool) or self.Weapons[Tool]
        local V = Tool:FindFirstChild("CurrentValues")
        if not V then return end
        local Suspended = self.Suspended
        local TypeValue = V:FindFirstChild("FireType")
        local TypeRecord = TypeValue and self.Values[TypeValue]
        local NativeType = TypeRecord and (TypeValue.Value ~= TypeRecord.Applied and TypeValue.Value or TypeRecord.Original) or TypeValue and TypeValue.Value
        local Rapid = Flags.GunRapidFire == true and not Suspended and NativeType ~= "Charge"
        for _, Prefix in ipairs({"", "Alt"}) do
            Assign(V:FindFirstChild(Prefix .. "AttackSpeed"), self:RequestedRate(Tool) * 60, Rapid)
            Assign(V:FindFirstChild(Prefix .. "BurstDelay"), 0, Rapid)
        end
        Assign(V:FindFirstChild("FireType"), "FullAuto", Rapid)
        local SpreadEnabled = Flags.GunNoSpread == true and not Suspended and B ~= nil and B.UpdateSpread ~= nil
        local SpreadChanged = false
        for _, Prefix in ipairs({"", "Zoom", "Alt", "AltZoom"}) do
            local MinSpread = V:FindFirstChild(Prefix .. "Spread")
            local MaxSpread = V:FindFirstChild(Prefix .. "SpreadMax")
             
            local Integer = MaxSpread and (MaxSpread:IsA("IntValue") or MaxSpread.ClassName == "IntConstrainedValue")
            if Assign(MinSpread, Integer and 0 or 0.000001, SpreadEnabled) then SpreadChanged = true end
            if Assign(MaxSpread, Integer and 1 or 0.000002, SpreadEnabled) then SpreadChanged = true end
            if Assign(V:FindFirstChild(Prefix .. "SpreadIncrease"), 0, SpreadEnabled) then SpreadChanged = true end
        end
        if B then
            if SpreadChanged or B.NoSpreadApplied ~= SpreadEnabled then
                B.NoSpreadApplied = SpreadEnabled
                if B.UpdateSpread then pcall(B.UpdateSpread) end
            end
            if not BindingNeed then self:RestoreWeapon(B); self.Weapons[Tool] = nil end
        end
    end
    function F:ApplyWeapons()
        local Owned = {}
        local function Visit(Parent)
            if not Parent then return end
            for _, Tool in ipairs(Parent:GetChildren()) do
                if Tool:IsA("Tool") and Tool:FindFirstChild("GunScript") then
                    Owned[Tool] = true
                    local OK, Error = pcall(self.ApplyTool, self, Tool)
                    if not OK then Notify("weapon-" .. Tool.Name, "Gun controls: " .. tostring(Error)) end
                end
            end
        end
         
        Visit(P:FindFirstChildOfClass("Backpack"))
        Visit(P.Character)
        for Tool in pairs(self.Weapons) do if not Owned[Tool] then self:ReleaseWeapon(Tool) end end
        for Tool in pairs(self.Retries) do if not Owned[Tool] then self.Retries[Tool] = nil end end
        for Value, Record in pairs(self.Values) do
            local OK, IsOwned = pcall(function()
                return Value:IsDescendantOf(P) or P.Character and Value:IsDescendantOf(P.Character)
            end)
            if not OK or not IsOwned then
                pcall(function() if Value.Value == Record.Applied then Value.Value = Record.Original end end)
                self.Values[Value] = nil
            end
        end
    end
    function F:Refresh()
        if not self.Alive then return end
        local Need = NeedUpdates()
        if Need or next(self.Values) or next(self.Weapons) then self:ApplyWeapons() end
        if Need and not self.Heartbeat then
            self.Heartbeat = Run.Heartbeat:Connect(function()
                if not self.Alive or os.clock() - self.LastApply < 0.25 then return end
                self.LastApply = os.clock()
                local OK, Error = pcall(self.ApplyWeapons, self)
                if not OK then Notify("runtime", "Gun mods: " .. tostring(Error)) end
            end)
        elseif not Need and self.Heartbeat then
            Disconnect(self.Heartbeat); self.Heartbeat = nil
        end
    end
    function F:QueueRefresh()
        if self.Queued or not self.Alive then return end
        self.Queued = true
        task.defer(function() self.Queued = false; if self.Alive then self:Refresh() end end)
    end
    function F:SetSuspended(State)
        self.Suspended = State == true
        self:Refresh()
    end
    function F:WatchInventory(Parent, Key)
        for _, C in ipairs(self[Key] or {}) do Disconnect(C) end
        self[Key] = {}
        if Parent then
            for _, Signal in ipairs({Parent.ChildAdded, Parent.ChildRemoved}) do
                table.insert(self[Key], Signal:Connect(function(Child)
                    if Child:IsA("Tool") then self:QueueRefresh() end
                end))
            end
        end
        self:QueueRefresh()
    end
    local function OwnCallback(Item, Callback)
        local Record = {Previous = Item.Callback, Owned = Callback}
        F.Callbacks[Item] = Record
        Item.Callback = Callback
    end
    function F:Destroy()
        if not self.Alive then return end
        self.Alive = false
        if self.Heartbeat then Disconnect(self.Heartbeat); self.Heartbeat = nil end
        for _, C in ipairs(self.Connections) do Disconnect(C) end
        for _, Key in ipairs({"CharacterConnections", "BackpackConnections"}) do
            for _, C in ipairs(self[Key] or {}) do Disconnect(C) end
            self[Key] = {}
        end
        self:RestoreValues(nil)
        for _, B in pairs(self.Weapons) do self:RestoreWeapon(B) end
        for Item, Record in pairs(self.Callbacks) do
            if Item.Callback == Record.Owned then Item.Callback = Record.Previous end
        end
        table.clear(self.Connections); table.clear(self.Callbacks)
        table.clear(self.Weapons); table.clear(self.Retries)
    end
    F:WatchInventory(P.Character, "CharacterConnections")
    F:WatchInventory(P:FindFirstChildOfClass("Backpack"), "BackpackConnections")
    Connect(P.CharacterAdded, function(Character) F:WatchInventory(Character, "CharacterConnections") end)
    Connect(P.ChildAdded, function(Child)
        if Child:IsA("Backpack") then F:WatchInventory(Child, "BackpackConnections") end
    end)
    for _, Key in ipairs({"GunRapidFire", "GunNoSpread", "GunNoRecoil", "GunFireRate", "FarmAutoShoot"}) do
        local Item = Library.Items[Key]
        if Item then
            local Previous = Item.Callback
            OwnCallback(Item, function(Value) Previous(Value); F:QueueRefresh() end)
        end
    end
    F:Refresh()
    return F
end

end)()


local CreateShopAdapter = (function()
 
return function()
    local P: any = game:GetService("Players").LocalPlayer
    local RS: any = game:GetService("ReplicatedStorage")
    local W: any = workspace
    local Load: any = require
    local A: any = {Alive = true, Pending = nil, Context = nil}
    function A:Levels(Name)
        local U = P:FindFirstChild("Upgrades")
        U = U and U:FindFirstChild("GunUpgrades")
        return U and U:FindFirstChild(Name)
    end
    function A:InShop()
        local V = P:FindFirstChild("InsideShop")
        return V ~= nil and V.Value == true
    end
    function A:BetweenRounds()
        local Z = W:FindFirstChild("Zombies")
        local Values = RS:FindFirstChild("Values")
        local Vote = Values and Values:FindFirstChild("Vote")
        if Vote then
            local Time = game:GetService("Lighting"):GetMinutesAfterMidnight()
            return Vote.Value == true and Time >= 360 and Time < 1080
        end
        local G = P:FindFirstChild("PlayerGui")
        local Button = G and G:FindFirstChild("VoteSkip", true)
        return Z ~= nil and #Z:GetChildren() == 0 and Button ~= nil
            and type(Button.Text) == "string" and Button.Text:find("Ready", 1, true) ~= nil
    end
    function A:CanReady()
        local Values = RS:FindFirstChild("Values")
        local Vote = Values and Values:FindFirstChild("Vote")
        if Vote then return Vote.Value == true end
        return self:BetweenRounds()
    end
    function A:OwnedTool(Name)
        local Bag = P:FindFirstChildOfClass("Backpack")
        return Bag and Bag:FindFirstChild(Name) or P.Character and P.Character:FindFirstChild(Name)
    end
    function A:GetContext()
        if self.Context and self.Context.Frame.Parent then return self.Context end
        local Scripts = P:FindFirstChild("PlayerScripts")
        local Manager = Scripts and Scripts:FindFirstChild("GuiManager")
        local Main = Manager and Manager:FindFirstChild("MainGui")
        local Module = Main and Main:FindFirstChild("ShopGui")
        if not Module then return nil end
        local Shop = Load(Module)
        if type(Shop) ~= "table" or type(Shop.Next) ~= "function" then return nil end
        local Update = getfenv(Shop.Next).UpdateUpgrade
        if type(Update) ~= "function" or debug.getinfo(Update).nups < 18 then return nil end
         
        local Frame = debug.getupvalue(Update, 4)
        local Info = debug.getupvalue(Update, 8)
        if typeof(Frame) ~= "Instance" or Frame.Name ~= "ShopFrame"
            or typeof(Info) ~= "Instance" then return nil end
        local NativeFrame: any = Frame
        local NativeInfo: any = Info
        if not NativeFrame:FindFirstChild("Upgrade") or not NativeInfo:FindFirstChild("UpgradesFrame") then return nil end
        self.Context = {Update = Update, Frame = NativeFrame, Information = NativeInfo}
        return self.Context
    end
    function A:TryPurchase(Weapon, OrderedLevels, CashReserve)
        if not self.Alive or self.Pending or self.RestockPending or self.ReadyPending then return nil, "Waiting for confirmation" end
        if not self:BetweenRounds() then return nil, "Waiting for round end" end
        if not self:InShop() then return nil, "Enter the shop to upgrade" end
        if not self.Confirmation then return nil, "Native confirmation event unavailable" end
        local Tool = self:OwnedTool(Weapon)
        local Money = P:FindFirstChild("ReplicatedMoney")
        if not Tool or not Money then return nil, "Weapon is not ready" end
        if CashReserve == nil then CashReserve = 0 end
        if type(CashReserve) ~= "number" or CashReserve ~= CashReserve or math.abs(CashReserve) == math.huge then return nil, "Invalid cash reserve" end
        CashReserve = math.max(0, CashReserve)
        local Context = self:GetContext()
        if not Context then return nil, "Shop version unsupported" end
        if Context.Frame.Visible then return nil, "Close the native shop menu" end
        local Update = Context.Update
        local PreviousWeapon = debug.getupvalue(Update, 5)
        local PreviousMode = Context.Frame.Upgrade.Value
        local Pending, Reason = nil, "Remaining upgrades locked"
        local OK, Error = pcall(function()
            debug.setupvalue(Update, 5, Weapon)
            Context.Frame.Upgrade.Value = false
            Update()
            local Rows = Context.Information.UpgradesFrame.Upgrades
            for _, Level in ipairs(OrderedLevels) do
                if Level.Value < Level.MaxValue then
                    local Row = Rows:FindFirstChild(Level.Name .. " Upgrade")
                    local Buy = Row and Row:FindFirstChild("Buy")
                    local Text = Buy and Buy.Text
                    local Price = type(Text) == "string" and Text:match("^Buy:%s*%$([%d,]+)%s*$")
                    Price = Price and tonumber((Price:gsub(",", "")))
                    if Row and Row.Visible and Buy and Buy.Visible and Price and Price >= 0 then
                        if Price + CashReserve > Money.Value then
                            Reason = "Waiting for cash ($" .. tostring(Price) .. ")"
                             
                        else
                            local Handler
                            for _, Connection in ipairs(getconnections(Row.MouseButton1Click)) do
                                if Connection.Enabled and type(Connection.Function) == "function" then Handler = Connection.Function; break end
                            end
                            if not Handler then Reason = "Native buy handler unavailable"; return end
                            Pending = {Weapon = Weapon, Level = Level, Before = Level.Value,
                                Price = Price, Started = os.clock(), Confirmed = false}
                             
                            self.Pending = Pending
                            Handler()
                            return
                        end
                    end
                end
            end
        end)
         
        pcall(debug.setupvalue, Update, 5, PreviousWeapon)
        pcall(function() Context.Frame.Upgrade.Value = PreviousMode; Update() end)
        if not OK then
            if self.Pending then
                 
                self.Pending.Error = tostring(Error)
                return self.Pending, "Waiting for confirmation"
            end
            return nil, "Native shop could not update"
        end
        return Pending, Pending and "Waiting for confirmation" or Reason
    end
    function A:AmmoBox()
        local Map = W:FindFirstChild("Map")
        local Upgrades = Map and Map:FindFirstChild("Upgrades")
        return Upgrades and Upgrades:FindFirstChild("AmmoBox")
    end
    function A:RestockContext()
        local Scripts = P:FindFirstChild("PlayerScripts")
        local Manager = Scripts and Scripts:FindFirstChild("GuiManager")
        local Main = Manager and Manager:FindFirstChild("MainGui")
        local Shop = Main and Main:FindFirstChild("ShopGui")
        local Module = Shop and Shop:FindFirstChild("ShopPurchase")
        if not Module then return nil end
        local Purchase = Load(Module)
        local Fn = type(Purchase) == "table" and Purchase.RepairStructure
        if type(Fn) ~= "function" or debug.getinfo(Fn).nups ~= 5 then return nil end
        local Utility = debug.getupvalue(Fn, 3)
        local Remote = debug.getupvalue(Fn, 4)
        if debug.getupvalue(Fn, 1) ~= P or type(Utility) ~= "table" or type(Utility.GetStructureRepairInfo) ~= "function"
            or typeof(Remote) ~= "Instance" or Remote.Name ~= "SellRepair" then return nil end
        return {Purchase = Purchase, Utility = Utility}
    end
    function A:TryRestock(Threshold)
        if not self.Alive or self.Pending or self.RestockPending or self.ReadyPending then return nil, "Another purchase is pending" end
        if not self:BetweenRounds() then return nil, "Restock waits for round end" end
        local Minutes = game:GetService("Lighting"):GetMinutesAfterMidnight()
        if Minutes < 360 or Minutes >= 1080 then return nil, "Restock is daytime only" end
        if not self:InShop() then return nil, "Enter the shop to restock" end
        local Frame = self:GetContext()
        if not Frame or Frame.Frame.Visible then return nil, "Close the native shop menu" end
        local Box = self:AmmoBox()
        if not Box or not Box:FindFirstChild("Ammo") or not Box:FindFirstChild("MaxAmmo")
            or Box.MaxAmmo.Value <= 0 then return nil, "Ammo box unavailable" end
        if Box.Ammo.Value > Box.MaxAmmo.Value * math.clamp(Threshold, 5, 50) / 100 then return nil, "Ammo box stock sufficient" end
        local Values = RS:FindFirstChild("Values")
        local Wave = Values and Values:FindFirstChild("LocalWave")
        if not Wave then return nil, "Round identity unavailable" end
        if self.RestockAttemptedWave == Wave.Value then return nil, "Restock already attempted this round" end
        local First = P:FindFirstChild("FirstWave")
        if First and First.Value then return nil, "Survive one night before restocking" end
        local Money = P:FindFirstChild("ReplicatedMoney")
        local Context = self:RestockContext()
        if not Money or not Context then return nil, "Native restock version unsupported" end
        local Amount, Price = Context.Utility:GetStructureRepairInfo("AmmoBox", Money.Value)
        local function Finite(N) return type(N) == "number" and N == N and math.abs(N) < math.huge end
        if not Finite(Amount) or not Finite(Price) or Amount <= 0 or Price <= 0 or Price > Money.Value then
            return nil, "Waiting for restock cash"
        end
        local Record = {Started = os.clock(), Box = Box, BeforeStock = Box.Ammo.Value,
            BeforeCash = Money.Value, Price = Price, Amount = Amount}
        self.RestockPending = Record
         
         
        self.RestockAttemptedWave = Wave.Value
        local OK, Error = pcall(Context.Purchase.RepairStructure, Context.Purchase, "AmmoBox")
        Record.Error = not OK and tostring(Error) or nil
        return Record, "Native restock submitted"
    end
    function A:PollRestock()
        local Record = self.RestockPending
        if not Record then return "idle" end
        if os.clock() - Record.Started < 1 then return "waiting", Record end
        self.RestockPending = nil
        Record.AfterStock = Record.Box.Parent and Record.Box.Ammo.Value or Record.BeforeStock
        return Record.Error and "unconfirmed" or "submitted", Record
    end
    function A:TryReady()
        if not self.Alive or self.Pending or self.RestockPending or self.ReadyPending then return nil, "Waiting for shop transactions" end
        if not self:CanReady() then return nil, "Waiting for round end" end
        local Voted = P:FindFirstChild("Voted")
        if not Voted then return nil, "Native ready state unavailable" end
        if Voted.Value == true then return nil, "Ready; waiting for other players" end
        local Values = RS:FindFirstChild("Values")
        local Wave = Values and Values:FindFirstChild("LocalWave")
        if not Wave or self.ReadyAttemptedWave == Wave.Value then return nil, "Ready already attempted this round" end
        local Scripts = P:FindFirstChild("PlayerScripts")
        local Manager = Scripts and Scripts:FindFirstChild("GuiManager")
        local Main = Manager and Manager:FindFirstChild("MainGui")
        local Module = Main and Main:FindFirstChild("SkipGui")
        if not Module then return nil, "Native ready version unsupported" end
        local Native = Load(Module)
        local Fn = type(Native) == "table" and Native.Vote
        if type(Fn) ~= "function" or debug.getinfo(Fn).nups ~= 6 then return nil, "Native ready version unsupported" end
        local Remote = debug.getupvalue(Fn, 5)
        if debug.getupvalue(Fn, 1) ~= P or typeof(Remote) ~= "Instance" or Remote.Name ~= "VoteSkip" then return nil, "Native ready version unsupported" end
        if debug.getupvalue(Fn, 2) ~= false then return nil, "Native ready request busy" end
        local Record = {Done = false, Started = os.clock()}
        self.ReadyPending = Record
        task.spawn(function()
            if not self.Alive or self.CanStart and not self.CanStart() or not self:CanReady() then
                Record.Cancelled = true; Record.Done = true; return
            end
            if Voted.Value == true then Record.Ready = true; Record.Done = true; return end
            self.ReadyAttemptedWave = Wave.Value
            Record.Submitted = true
            local OK, Error = pcall(Fn, Native)
            Record.Error = not OK and tostring(Error) or nil
            Record.Ready = OK and Voted.Parent ~= nil and Voted.Value == true
            Record.Done = true
        end)
        return Record, "Sending native Ready vote"
    end
    function A:PollReady()
        local Record = self.ReadyPending
        if not Record then return "idle" end
        if not Record.Done then return "waiting" end
        self.ReadyPending = nil
        return Record.Cancelled and "cancelled" or Record.Ready and "ready" or "unconfirmed"
    end
    function A:Poll()
        local Pending = self.Pending
        if not Pending then return "idle" end
        if Pending.Confirmed then
            self.Pending = nil
            if Pending.Level.Parent and Pending.Level.Value > Pending.Before then return "confirmed", Pending end
            return "rejected", Pending
        end
        if os.clock() - Pending.Started >= 6 then
            self.Pending = nil
             
            return "timeout", Pending
        end
        return "waiting", Pending
    end
    function A:Destroy()
        self.Alive = false
        if self.Confirmation then self.Confirmation:Disconnect() end
        self.Pending = nil
        self.RestockPending = nil
        self.ReadyPending = nil
    end
    local Remotes = RS:FindFirstChild("RemoteEvents")
    local Result = Remotes and Remotes:FindFirstChild("RefreshItemStats")
    if Result then
        A.Confirmation = Result.OnClientEvent:Connect(function(Weapon, Structure)
            if A.Alive and A.Pending and not Structure and A.Pending.Weapon == Weapon then A.Pending.Confirmed = true end
        end)
    end
    return A
end

end)()


local CreateNavigation = (function()
 
return function()
    local W: any = workspace
    local P: any = game:GetService("Players").LocalPlayer
    local Paths = game:GetService("PathfindingService")
    local N: any = {Alive = true, NextPlan = 0, LastProgress = 0}
    local function Flat(V) return Vector3.new(V.X, 0, V.Z) end
    local function Unit(V) return V.Magnitude > 0.001 and V.Unit or Vector3.zero end
    function N:Params(Root)
        local R = RaycastParams.new()
        R.FilterType = Enum.RaycastFilterType.Exclude
        local Ignore = {}
        if P.Character then table.insert(Ignore, P.Character) end
        local Z = W:FindFirstChild("Zombies")
        if Z then table.insert(Ignore, Z) end
        if W.CurrentCamera then table.insert(Ignore, W.CurrentCamera) end
        R.FilterDescendantsInstances = Ignore; R.RespectCanCollide = true
        if Root and type(Root.CollisionGroup) == "string" then R.CollisionGroup = Root.CollisionGroup end
        return R
    end
    function N:Ground(Position, Params)
        return W:Raycast(Position + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), Params)
    end
    function N:Separation(Position, Zombies)
        local Squared, Away = math.huge, Vector3.zero
        for _, Z in ipairs(Zombies) do
            if Z.Head.Parent and Z.Humanoid.Health > 0 then
                local Delta = Flat(Position - Z.Head.Position)
                Squared = math.min(Squared, Delta:Dot(Delta))
            end
        end
        local Distance = math.sqrt(Squared)
        local Band = math.max(20, Distance * 2)
        for _, Z in ipairs(Zombies) do
            if Z.Head.Parent and Z.Humanoid.Health > 0 then
                local Delta = Flat(Position - Z.Head.Position)
                local D2 = Delta:Dot(Delta)
                if D2 <= Band * Band then Away = Away + Unit(Delta) / math.max(4, D2) end
            end
        end
        return Distance, Unit(Away)
    end
    function N:SweptGap(Start, Finish, Zombies, Speed)
        local Delta = Flat(Finish - Start)
        Speed = math.max(1, Speed or 16)
        local Duration = math.min(2, Delta.Magnitude / Speed)
        local Velocity = Unit(Delta) * Speed
        local GapSquared = math.huge
        for _, Z in ipairs(Zombies) do
            if Z.Head.Parent and Z.Humanoid.Health > 0 then
                local EnemyVelocity = Z.Head.AssemblyLinearVelocity
                if typeof(EnemyVelocity) ~= "Vector3" or EnemyVelocity:Dot(EnemyVelocity) ~= EnemyVelocity:Dot(EnemyVelocity)
                    or EnemyVelocity.Magnitude > 200 then EnemyVelocity = Vector3.zero end
                local Offset = Flat(Start - Z.Head.Position)
                local Relative = Velocity - Flat(EnemyVelocity)
                local Denominator = Relative:Dot(Relative)
                local Time = Denominator > 0.000001 and math.clamp(-Offset:Dot(Relative) / Denominator, 0, Duration) or 0
                local Closest = Offset + Relative * Time
                GapSquared = math.min(GapSquared, Closest:Dot(Closest))
            end
        end
        return math.sqrt(GapSquared)
    end
    function N:RefillGap(Position, Zombies, Seconds)
        local Nearest, Deficit = math.huge, 0
        for _, Z in ipairs(Zombies) do
            if Z.Head.Parent and Z.Humanoid.Health > 0 then
                local Distance = Flat(Position - Z.Head.Position).Magnitude
                local Speed = Z.Humanoid.WalkSpeed
                Speed = type(Speed) == "number" and Speed == Speed and math.clamp(Speed, 0, 100) or 16
                Nearest = math.min(Nearest, Distance)
                Deficit = math.max(Deficit, 8 + Speed * (Seconds + 0.25) - Distance)
            end
        end
        return Nearest < math.huge and math.max(10, Nearest + Deficit) or 10
    end
    function N:Segment(Root, Direction, Length, Params, FloorY)
        local Hit = W:Blockcast(CFrame.new(Root.Position + Vector3.new(0, 0.3, 0)),
            Vector3.new(3, 4.2, 3), Direction * Length, Params)
        local Clearance = Hit and Hit.Distance or Length
        if Clearance < 2.8 then return false, Clearance end
        local Travel = math.min(Length, Clearance - 0.7)
        for I = 1, 3 do
            local Ground = self:Ground(Root.Position + Direction * (Travel * I / 3), Params)
            if not Ground or Ground.Normal.Y < 0.6 or FloorY and math.abs(Ground.Position.Y - FloorY) > 3 then return false, Clearance end
        end
        return true, Clearance
    end
    function N:LocalDirection(Root, Zombies, Radius, Params, FloorY, Away)
        local Nearest = self:Separation(Root.Position, Zombies)
        local function Score(D)
            if not D or D.Magnitude < 0.01 then return nil end
            local Valid, Clearance = self:Segment(Root, D, self.LookAhead or 8, Params, FloorY)
            if not Valid then return nil end
            local Finish = Root.Position + D * math.min(self.LookAhead or 7, Clearance - 0.8)
            local Safe = self:Separation(Finish, Zombies)
            local Gap = self:SweptGap(Root.Position, Finish, Zombies, self.Speed)
            if math.min(Safe, Gap) < math.max(1, math.min(Nearest - 1.5, 6)) then return nil end
            local Value = math.min(Gap, Radius + 20) * 2 + math.min(Safe, Radius + 20) * 3 + D:Dot(Away) * 5 + Clearance
            if self.StuckDirection then Value = Value - math.max(0, D:Dot(self.StuckDirection)) * 18 end
            return Value, Safe
        end
        local DirectScore, DirectSafety = Score(Away)
        self.DirectClear = DirectScore ~= nil and DirectSafety >= Nearest + 1 and not self.StuckDirection
        local OldScore = Score(self.LastDirection)
        if self.DirectClear then
             
            if OldScore and self.LastDirection:Dot(Away) > 0.8 and OldScore >= DirectScore - 3 then return self.LastDirection end
            return Away
        end
        local Best, BestScore = nil, -math.huge
        for I = 0, 15 do
            local Angle = I * math.pi / 8
            local D = Vector3.new(math.cos(Angle), 0, math.sin(Angle))
            local Value = Score(D)
            if Value and Value > BestScore then Best = D; BestScore = Value end
        end
        if OldScore and OldScore >= BestScore - 3 then return self.LastDirection end
        return Best
    end
    function N:Plan(Root, Zombies, Radius, Away, Params, FloorY)
        if self.Route or self.Planning or os.clock() < self.NextPlan then return end
        self.Planning = true; self.NextPlan = os.clock() + 0.8
        local Token = {}; self.Token = Token
        local Start = Root.Position
        local Candidates = {}
         
        for _, Distance in ipairs({math.clamp(Radius + 8, 20, 45), math.clamp(Radius * 0.6, 14, 25), math.clamp(Radius * 0.3, 8, 12)}) do
            local BestGoal
            for I = 0, 15 do
                local Angle = I * math.pi / 8
                local D = Vector3.new(math.cos(Angle), 0, math.sin(Angle))
                local Goal = Start + D * Distance
                local G = self:Ground(Goal, Params)
                if G and G.Normal.Y >= 0.6 and math.abs(G.Position.Y - FloorY) < 5 then
                    local Safe = self:Separation(G.Position, Zombies)
                    local Score = math.min(Safe, Radius + 30) * 3 + D:Dot(Away) * 8
                    if self.StuckDirection then Score = Score - math.max(0, D:Dot(self.StuckDirection)) * 25 end
                    if not BestGoal or Score > BestGoal.Score then BestGoal = {Position = G.Position, Score = Score} end
                end
            end
            if BestGoal then table.insert(Candidates, BestGoal) end
        end
        task.spawn(function()
            local Best, BestScore = nil, -math.huge
            for I = 1, math.min(3, #Candidates) do
                if not self.Alive or self.Token ~= Token then return end
                local Candidate = Candidates[I]
                local OK, Route = pcall(function()
                    local Path = Paths:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 4})
                    Path:ComputeAsync(Start, Candidate.Position)
                    if Path.Status == Enum.PathStatus.Success then return Path:GetWaypoints() end
                    return nil
                end)
                if OK and Route and #Route >= 2 then
                    local Safe, Length, MinDistance = true, 0, math.huge
                    local InitialDistance = self:Separation(Start, Zombies)
                    for J = 2, #Route do
                        local Separation = math.min(self:Separation(Route[J].Position, Zombies),
                            self:SweptGap(Route[J - 1].Position, Route[J].Position, Zombies, self.Speed))
                        MinDistance = math.min(MinDistance, Separation)
                        Length = Length + (Route[J].Position - Route[J - 1].Position).Magnitude
                        if Separation < math.min(8, math.max(1, InitialDistance - 2)) then Safe = false end
                    end
                    local Score = Candidate.Score + math.min(MinDistance, Radius + 15) * 2 - Length * 0.1
                    if Safe and Score > BestScore then Best = Route; BestScore = Score; break end
                end
            end
            if not self.Alive or self.Token ~= Token then return end
            self.Planning = false
            if Best and (Root.Position - Start).Magnitude < 10 then
                self.Route = Best; self.Index = 2; self.RouteAt = os.clock(); self.JumpIndex = nil
            end
        end)
    end
    function N:Reset()
        self.Token = nil; self.Planning = false; self.Route = nil; self.Active = false
        self.LastDirection = nil; self.Position = nil; self.NextPlan = 0
        self.Index = nil; self.RouteAt = nil; self.StuckDirection = nil; self.StuckUntil = nil; self.DirectClear = nil
    end
    function N:Update(H, Root, Zombies, Radius)
        local Speed = H and H.WalkSpeed
        self.Speed = type(Speed) == "number" and Speed == Speed and math.clamp(Speed, 1, 100) or 16
        self.LookAhead = math.clamp(self.Speed * 0.35 + 3, 6, 12)
        local Nearest, Away = self:Separation(Root.Position, Zombies)
        self.Nearest = Nearest
        if not self.Active and Nearest >= Radius or self.Active and Nearest >= Radius + 8 then
            self:Reset(); self.Status = "Safe distance"; return nil
        end
        self.Active = true
        local Params = self:Params(Root)
        local Ground = self:Ground(Root.Position, Params)
        if not Ground then self.Status = "No ground; retreat paused"; return nil end
        if self.StuckUntil and os.clock() >= self.StuckUntil then self.StuckDirection = nil end
        if not self.Position or os.clock() - self.LastProgress >= 1 then
            if self.Position and self.LastDirection and (Root.Position - self.Position).Magnitude < 0.8 then
                self.StuckDirection = self.LastDirection; self.StuckUntil = os.clock() + 2
                self.Token = nil; self.Planning = false; self.Route = nil; self.NextPlan = 0
            end
            self.Position = Root.Position; self.LastProgress = os.clock()
        end
        local Direction
        if self.Route then
            local Point = self.Route[self.Index]
            local function Reached()
                if not Point then return false end
                if (Point.Position - Root.Position).Magnitude < 3 then return true end
                local Previous = self.Route[self.Index - 1]
                if not Previous then return false end
                local Segment = Flat(Point.Position - Previous.Position)
                local Offset = Flat(Root.Position - Point.Position)
                if Segment.Magnitude < 0.01 then return true end
                local Forward = Segment.Unit
                return Offset:Dot(Forward) >= 0 and (Offset - Forward * Offset:Dot(Forward)).Magnitude < 3
            end
            while Reached() do
                if Point.Action == Enum.PathWaypointAction.Jump then H.Jump = true end
                self.Index = self.Index + 1; Point = self.Route[self.Index]
            end
            if Point and os.clock() - self.RouteAt < 4 then
                if Point.Action == Enum.PathWaypointAction.Jump and (Point.Position - Root.Position).Magnitude < 6 and self.JumpIndex ~= self.Index then
                    H.Jump = true; self.JumpIndex = self.Index
                end
                Direction = Unit(Flat(Point.Position - Root.Position))
                local Valid = self:Segment(Root, Direction, math.min(5, math.max(3, (Point.Position - Root.Position).Magnitude)), Params, Ground.Position.Y)
                local Finish = Root.Position + Direction * math.min(5, (Point.Position - Root.Position).Magnitude)
                local Gap = self:SweptGap(Root.Position, Finish, Zombies, self.Speed)
                if not Valid or Gap < math.max(1, math.min(Nearest - 1.5, 6)) then self.Route = nil; self.NextPlan = 0; Direction = nil end
            else self.Route = nil; self.NextPlan = 0 end
        end
        if not Direction or Direction.Magnitude < 0.01 then
            Direction = self:LocalDirection(Root, Zombies, Radius, Params, Ground.Position.Y, Away)
             
            if not self.DirectClear then self:Plan(Root, Zombies, Radius, Away, Params, Ground.Position.Y) end
        end
        self.LastDirection = Direction
        self.Status = Direction and "Retreating via clear path" or "Blocked; searching for a route"
        return Direction
    end
    function N:Destroy() self.Alive = false; self:Reset() end
    return N
end

end)()


local CreateAmmoAdapter = (function()
 
return function()
    local P: any = game:GetService("Players").LocalPlayer
    local W: any = workspace
    local Load: any = require
    local A: any = {Alive = true, Pending = nil, NextTry = 0, LastBoxes = -10, Boxes = {}, BlockedUntil = {}}
    function A:Context()
        local Scripts = P:FindFirstChild("PlayerScripts")
        local Gui = Scripts and Scripts:FindFirstChild("GuiManager")
        local Module = Gui and Gui:FindFirstChild("MainGui")
        if not Module then return nil end
        local Main = Load(Module)
        local Fn = type(Main) == "table" and type(Main.Init) == "function" and getfenv(Main.Init).AmmoCrate
        if type(Fn) ~= "function" or debug.getinfo(Fn).nups ~= 11 then return nil end
        local Manager = debug.getupvalue(Fn, 6)
        local Remote = debug.getupvalue(Fn, 7)
        if type(Manager) ~= "table" or type(Manager.GetMulti) ~= "function" or typeof(Remote) ~= "Instance"
            or Remote.Name ~= "RemoteRefillAmmo" then return nil end
        return {Function = Fn, Manager = Manager}
    end
    function A:Ratio(Tool)
        local V = Tool and Tool:FindFirstChild("CurrentValues")
        if not V or not V:FindFirstChild("Ammo") or not V:FindFirstChild("MaxAmmo") or V.MaxAmmo.Value <= 0 then return math.huge, 0 end
        local Capacity = V.MaxAmmo.Value
        local Context = self:Context()
        if Context then
            local OK, Multi = pcall(Context.Manager.GetMulti, Context.Manager, "MaxAmmo", P, {Tool = Tool})
            if OK and type(Multi) == "number" and Multi > 0 and Multi < math.huge then Capacity = Capacity * Multi end
        end
        if V.Ammo.Value < 0 or Capacity ~= Capacity or Capacity >= math.huge then return math.huge, 0 end
        return V.Ammo.Value / Capacity, Capacity
    end
    function A:Needs(Tool, Threshold)
        local Ratio, Capacity = self:Ratio(Tool)
        return Capacity > 0 and Ratio <= math.max(1 / Capacity, math.clamp(Threshold or 20, 5, 90) / 100)
    end
    function A:Eligible(Box, AllowEmpty)
        if not Box or not Box.Parent or not Box.PrimaryPart or not Box:FindFirstChild("Time")
            or not Box:FindFirstChild("Ammo") or not Box:FindFirstChild("MaxAmmo") or not AllowEmpty and Box.Ammo.Value <= 0 then return false end
        local Only = Box:FindFirstChild("CreatorOnly")
        local Creator = Box:FindFirstChild("Creator")
        return not Only or not Only.Value or Creator and Creator.Value == P
    end
    function A:Avoid(Box, Seconds)
        self.BlockedUntil[Box] = os.clock() + (Seconds or 8)
    end
    function A:NativeBox(Root)
        local Map = W:FindFirstChild("Map")
        local Upgrades = Map and Map:FindFirstChild("Upgrades")
        local Box = Upgrades and Upgrades:FindFirstChild("AmmoBox")
        local Roof = Upgrades and Upgrades:FindFirstChild("RoofAmmo")
        if Root.Position.X <= 0 and Roof and self:Eligible(Roof, true) then Box = Roof end
        local Deployables = W:FindFirstChild("Deployables")
        if Deployables then
            for _, Group in ipairs(Deployables:GetChildren()) do
                for _, B in ipairs(Group:GetChildren()) do
                    if (B.Name == "DeployableAmmo" or B.Name == "SupplyCrate") and self:Eligible(B, true)
                        and (Root.Position - B.PrimaryPart.Position).Magnitude < 8 then Box = B end
                end
            end
        end
        return Box
    end
    function A:Nearest(Root, Cost)
        if os.clock() - self.LastBoxes >= 1 then
            self.LastBoxes = os.clock(); self.Boxes = {}
            local Map = W:FindFirstChild("Map")
            local Upgrades = Map and Map:FindFirstChild("Upgrades")
            for _, Name in ipairs({"AmmoBox", "RoofAmmo"}) do
                local B = Upgrades and Upgrades:FindFirstChild(Name)
                if B then table.insert(self.Boxes, B) end
            end
            local Deployables = W:FindFirstChild("Deployables")
            if Deployables then
                for _, Group in ipairs(Deployables:GetChildren()) do
                    for _, B in ipairs(Group:GetChildren()) do
                        if B.Name == "DeployableAmmo" or B.Name == "SupplyCrate" then table.insert(self.Boxes, B) end
                    end
                end
            end
        end
        local Best, Distance, Score = nil, math.huge, math.huge
        for _, B in ipairs(self.Boxes) do
            if self:Eligible(B) and os.clock() >= (self.BlockedUntil[B] or 0) then
                local D = (Root.Position - B.PrimaryPart.Position).Magnitude
                local S = Cost and Cost(B, D) or D
                if type(S) == "number" and S < Score then Best = B; Distance = D; Score = S end
            end
        end
        return Best, Distance
    end
    function A:Duration(Box, Context)
        local Time = Box.Time.Value
        local Minutes = game:GetService("Lighting"):GetMinutesAfterMidnight()
        if Minutes >= 360 and Minutes < 1080 then Time = Time / 5 end
        return Time / math.max(0.1, Context.Manager:GetMulti("InteractionSpeed", P, {IgnoreTool = true}))
    end
    function A:Begin(Tool, Box, Root)
        if not self.Alive or self.Pending or os.clock() < self.NextTry then return false, "Refill cooling down" end
        if not self:Eligible(Box) then return false, "Ammo box empty or unavailable" end
        if (Root.Position - Box.PrimaryPart.Position).Magnitude >= 8 then return false, "Move within 8 studs of box" end
        if self:NativeBox(Root) ~= Box then self:Avoid(Box); return false, "Native interaction selects another box" end
        local Gui = P:FindFirstChild("PlayerGui")
        if Gui and Gui:FindFirstChild("MenuGui") then return false, "Close the native game menu" end
        local Reloading = Tool:FindFirstChild("Reloading")
        if Tool.Parent ~= P.Character or not Reloading or Reloading.Value then return false, "Waiting for equipped gun" end
        local Context = self:Context()
        if not Context then return false, "Native refill version unsupported" end
        if debug.getupvalue(Context.Function, 3) ~= false then return false, "Native interaction already busy" end
        local Record = {Tool = Tool, Box = Box, Before = Tool.CurrentValues.Ammo.Value, Started = os.clock(), Done = false}
        self.Pending = Record; self.NextTry = os.clock() + 3
        task.spawn(function()
            if not self.Alive or self.CanStart and not self.CanStart() then Record.Done = true; Record.Error = "Cancelled"; return end
            local OK, Error = pcall(Context.Function)
            if not OK and debug.getupvalue(Context.Function, 3) == true then
                 
                debug.setupvalue(Context.Function, 3, false)
                Tool.Enabled = true
                local UI: any = debug.getupvalue(Context.Function, 4)
                pcall(function() UI.Progress.Visible = false; UI.Progress.ProgressBar.Visible = false end)
            end
            Record.OK = OK; Record.Error = not OK and tostring(Error) or nil
            Record.After = Tool.Parent and Tool.CurrentValues.Ammo.Value or Record.Before
            Record.Seconds = os.clock() - Record.Started
            Record.Done = true
        end)
        return true, "Refilling reserve at native speed"
    end
    function A:Poll()
        local R = self.Pending
        if not R then return "idle" end
        if not R.Done then return "waiting", R end
        self.Pending = nil
        if R.OK and R.After > R.Before then return "refilled", R end
        self:Avoid(R.Box)
        return "failed", R
    end
    function A:Destroy() self.Alive = false end
    return A
end

end)()


local CreateAutomation = (function()
 
return function(Library: any, Window: any, Guns: any, CreateShopAdapter: any, CreateNavigation: any, CreateAmmoAdapter: any)
    local P: any = game:GetService("Players").LocalPlayer
    local Run = game:GetService("RunService")
    local Input = game:GetService("UserInputService")
    local GuiService = game:GetService("GuiService")
    local Paths = game:GetService("PathfindingService")
    local RS: any = game:GetService("ReplicatedStorage")
    local W: any = workspace
    local Flags = Library.Flags
    local A: any = {Alive = true, Connections = {}, Watches = {}, Callbacks = {}, Inventory = {},
        Shop = CreateShopAdapter(), Navigation = CreateNavigation(), Refill = CreateAmmoAdapter(), Zombies = {}, LastScan = -10, LastStep = -10, LastVisual = -10,
        LastBuy = -10, NextPress = 0, Lines = {}, Notices = {}, InventoryDirty = true, WindowFocused = isrbxactive() == true}
    A.Refill.CanStart = function() return A.Alive and A:Focused() end
    A.Shop.CanStart = function() return A.Alive and A:Focused() end
    local RenderName = "NeoperroAutomation"
    local function Connect(Signal, Callback, Bucket)
        local C = Signal:Connect(Callback)
        table.insert(Bucket or A.Connections, C)
        return C
    end
    local function Number(Value, Default, Min, Max)
        if type(Value) ~= "number" or Value ~= Value or math.abs(Value) == math.huge then return Default end
        return math.clamp(Value, Min, Max)
    end
    local function Flat(V) return Vector3.new(V.X, 0, V.Z) end
    local function Unit(V) return V.Magnitude > 0.001 and V.Unit or Vector3.zero end
    local function Value(Tool, Name, Default)
        local Values = Tool and Tool:FindFirstChild("CurrentValues")
        local V = Values and Values:FindFirstChild(Name)
        return V and V.Value or Default
    end
    local function IsLevel(L)
        return L and (L:IsA("IntConstrainedValue") or L:IsA("DoubleConstrainedValue"))
            and type(L.Value) == "number" and type(L.MaxValue) == "number"
    end
    local function Status(Key, Message)
